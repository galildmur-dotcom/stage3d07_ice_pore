+  STAGE3D10BA_POLAR_AUDIT STAGE3D10BD_TEMPORAL_AUDIT)
+if(MSVC)
+  target_compile_options(stage3d10bd_temporal_unit PRIVATE /O2 /W4)
+else()
+  target_compile_options(stage3d10bd_temporal_unit PRIVATE -O2 -Wall -Wextra -Wpedantic)
